---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>URL Shortener</title>
	</head>
	<body>
		<main class="card">
			<h1>URL Shortener</h1>
			<p class="subtitle">Paste a long link and get a short one.</p>

			<form id="shorten-form">
				<input
					id="url-input"
					type="url"
					placeholder="https://example.com/very/long/path"
					required
				/>
				<button type="submit" id="shorten-btn">Shorten</button>
			</form>

			<div id="result" hidden>
				<p class="label">Your short link</p>
				<a id="short-link" href="#" target="_blank" rel="noopener"></a>
				<p id="original-url" class="muted"></p>
				<p id="expiry" class="muted"></p>
			</div>

			<p id="error" class="error" hidden></p>
		</main>
	<script src="/src/scripts/shorten.ts"></script>
	</body>
</html>

<style>
	:root {
		color-scheme: light dark;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		display: grid;
		place-items: center;
		font-family: system-ui, sans-serif;
		background: #f4f4f5;
	}

	@media (prefers-color-scheme: dark) {
		body {
			background: #18181b;
		}
	}

	.card {
		width: min(480px, 90vw);
		padding: 2rem;
		border-radius: 12px;
		background: #fff;
		box-shadow: 0 10px 24px rgb(0 0 0 / 0.08);
	}

	@media (prefers-color-scheme: dark) {
		.card {
			background: #27272a;
		}
	}

	h1 {
		margin: 0 0 0.25rem;
		font-size: 1.5rem;
	}

	.subtitle {
		margin: 0 0 1.5rem;
		color: #71717a;
	}

	form {
		display: flex;
		gap: 0.5rem;
	}

	input {
		flex: 1;
		padding: 0.6rem 0.75rem;
		border: 1px solid #a1a1aa;
		border-radius: 8px;
		font-size: 1rem;
		background: transparent;
		color: inherit;
	}

	button {
		padding: 0.6rem 1rem;
		border: 0;
		border-radius: 8px;
		background: #2563eb;
		color: #fff;
		font-size: 1rem;
		font-weight: 600;
		cursor: pointer;
	}

	button:disabled {
		opacity: 0.6;
		cursor: default;
	}

	#result {
		margin-top: 1.5rem;
	}

	.label {
		margin: 0 0 0.25rem;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #71717a;
	}

	#short-link {
		font-weight: 600;
		color: #2563eb;
		word-break: break-all;
	}

	.muted {
		margin: 0.25rem 0 0;
		color: #71717a;
		font-size: 0.85rem;
		word-break: break-all;
	}

	.error {
		margin-top: 1.5rem;
		color: #dc2626;
	}
</style>